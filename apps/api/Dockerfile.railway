FROM node:26-alpine AS builder

WORKDIR /app

RUN apk add --no-cache openssl

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts

COPY prisma ./prisma
ENV PRISMA_CLI_BINARY_TARGETS=linux-musl-openssl-3.0.x
RUN npx prisma generate

COPY src ./src
COPY build.mjs tsconfig.json tsconfig.build.json ./
COPY openapi.yaml start.sh railway-predeploy.sh ./

RUN npm run build
RUN npm prune --omit=dev

FROM node:26-alpine AS runtime

WORKDIR /app

RUN apk add --no-cache openssl dumb-init

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodeuser

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/package-lock.json ./
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/openapi.yaml ./openapi.yaml
COPY --from=builder /app/start.sh ./start.sh
COPY --from=builder /app/railway-predeploy.sh ./railway-predeploy.sh
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

RUN chmod +x ./start.sh ./railway-predeploy.sh && chown -R nodeuser:nodejs /app
USER nodeuser

ENV NODE_ENV=production

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
    CMD node -e "const p=process.env.PORT||3001;require('http').get('http://localhost:'+p+'/health/live', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "./start.sh"]
